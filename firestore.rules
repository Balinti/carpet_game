rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Admin = a document admins/{uid} exists (added by hand, not from the app).
    function admin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if owner(uid);
    }

    match /users/{uid}/{document=**} {
      allow read: if owner(uid) || admin();
      allow write: if owner(uid);
    }

    // Dashboard reads across all users.
    match /{path=**}/assessments/{id} {
      allow read: if admin();
    }
    match /{path=**}/events/{id} {
      allow read: if admin();
    }
    match /{path=**}/questionnaires/{id} {
      allow read: if admin();
    }
  }
}
